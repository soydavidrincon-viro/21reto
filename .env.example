# Proyecto de Supabase.
#
# La llave sale de Project Settings -> API Keys, sección "Publishable key"
# (en proyectos viejos se llama "anon key" y empieza con eyJ). Es pública por
# diseño: viaja al navegador en cada carga, y lo que protege los datos son las
# políticas RLS del esquema, no esconderla.
#
# La URL sale de Project Settings -> Data API.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...


# ---------------------------------------------------------------------------
# Recordatorios
# ---------------------------------------------------------------------------

# El par de claves VAPID identifica a este servidor ante Google y Apple cuando
# manda un aviso. Se generan una vez y no se cambian: cambiarlas invalida todas
# las suscripciones y hay que volver a pedir permiso a todo el mundo.
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# La pública viaja al navegador; es pública por diseño, como la anon key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# La contraseña de /api/recordatorios. Ese endpoint puede notificar a toda la
# base, así que sin esto no responde. Cualquier cadena larga y aleatoria:
#
#   openssl rand -hex 32
CRON_SECRET=

# La clave de servicio de Supabase (Project Settings -> API Keys -> "Secret
# key"; en proyectos viejos, "service_role").
#
# Se salta TODAS las políticas RLS. La usa un solo archivo del proyecto
# —src/app/api/recordatorios/route.ts— porque para saber a quién le toca aviso
# hay que poder mirar a todo el mundo, y eso ninguna sesión de usuario puede
# hacerlo. No la pongas en ninguna variable que empiece por NEXT_PUBLIC_: eso
# la mandaría al navegador de cualquiera.
SUPABASE_SERVICE_ROLE_KEY=
